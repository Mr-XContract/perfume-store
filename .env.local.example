# Server-side only — never prefix with NEXT_PUBLIC_, never commit the real values.
HIGGSFIELD_API_BASE_URL=
HIGGSFIELD_API_KEY=

# Shopify Storefront API (headless). See README for how to get these:
# - SHOPIFY_STORE_DOMAIN: your-store.myshopify.com (no https://)
# - SHOPIFY_STOREFRONT_ACCESS_TOKEN: from a custom app's Storefront API scope
#   (Shopify admin -> Settings -> Apps and sales channels -> Develop apps)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10
