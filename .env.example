# Qué web de producto sirve este despliegue (ver src/sites/index.ts).
# Un proyecto de Vercel por web, todos con el mismo repositorio.
SITE_ID=manada

# Sitio y soporte
NEXT_PUBLIC_SITE_URL=https://tudominio.com
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@tudominio.com

# Píxeles de publicidad (opcionales)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Pago contra entrega: webhook que recibe cada pedido
# (Make, Zapier, Google Sheets, integración con Dropi…)
ORDER_WEBHOOK_URL=

# Pago con tarjeta: Stripe Checkout (clave secreta de tu cuenta de Stripe)
STRIPE_SECRET_KEY=
